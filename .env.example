# Client environment variables (Vite exposes only VITE_-prefixed vars to the browser).
# NEVER put secrets here — anything in the client bundle is public.

# Base path the contact form posts to. Default works for both dev (proxied) and prod (same origin).
VITE_API_BASE=/api

# Optional: override the dev proxy target if the Express server runs elsewhere.
# VITE_PROXY_TARGET=http://localhost:5000
